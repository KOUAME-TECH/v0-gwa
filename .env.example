# ============================================================
# GWA Platform — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# Supabase (obligatoire)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (Vercel ou local)
NEXT_PUBLIC_APP_URL=https://gwa-platform.vercel.app

# Feexpay — Paiement Mobile Money CI (https://feexpay.me)
FEEXPAY_API_KEY=fp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FEEXPAY_SHOP_ID=SHOP_XXXXXXXXXXXXXXXX
FEEXPAY_MODE=TEST

# Twilio — SMS OTP (configuré dans Supabase Auth dashboard, pas ici)
# Renseigner directement dans Supabase > Auth > Phone Providers > Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# OneSignal — Push notifications (https://onesignal.com)
ONESIGNAL_APP_ID=5f01e343-a7a2-4ae8-8baa-655388e239bc
ONESIGNAL_REST_API_KEY=os_v2_app_l4a6gq5hujforc5kmvjyryrzxqraxsoltttevmfaz7ymsfxp2n7t2yc5rk43cnlgshtpgachxjc3n3iespkw2pikqmecch6v272vaoy
NEXT_PUBLIC_ONESIGNAL_APP_ID=5f01e343-a7a2-4ae8-8baa-655388e239bc

# Africa's Talking — SMS fallback (https://africastalking.com)
AFRICASTALKING_USERNAME=gwa_platform
AFRICASTALKING_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry — Monitoring erreurs (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@xxxx.ingest.sentry.io/xxxxxxxx

# Sécurité interne
INTERNAL_API_TOKEN=changez_ce_token_secret_en_production
