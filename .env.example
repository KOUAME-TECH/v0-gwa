# ============================================================
# GWA Platform — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# Supabase (obligatoire)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (Vercel ou local)
NEXT_PUBLIC_APP_URL=https://mygwa.org

# Email de réception du formulaire contact
CONTACT_INBOX_TO=contact@mygwa.org
AGENTMAIL_API_KEY=your_agentmail_api_key
AGENTMAIL_INBOX_ID=contact@mygwa.org

# GeniusPay — paiement hébergé et webhook (https://geniuspay.ci)
GENIUSPAY_API_KEY=pk_sandbox_XXXXXXXXXXXXXXXX
GENIUSPAY_API_SECRET=sk_sandbox_XXXXXXXXXXXXXXXX
GENIUSPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Twilio — SMS OTP (configuré dans Supabase Auth dashboard, pas ici)
# Renseigner directement dans Supabase > Auth > Phone Providers > Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# OneSignal — Push notifications (https://onesignal.com)
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_REST_API_KEY=os_v2_app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Africa's Talking — SMS OTP et notifications (https://africastalking.com)
# AT_API_KEY est la clé Africa's Talking utilisée par l'application.
# AT_USERNAME doit être le username LIVE (jamais "sandbox" en production).
AT_USERNAME=gwa_platform
AT_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AT_SENDER_ID=GWA
AT_SANDBOX=false
# Alias historiques acceptés, à ne pas renseigner si les variables AT_* ci-dessus sont présentes.
# AFRICASTALKING_USERNAME=gwa_platform
# AFRICASTALKING_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OTP — pepper + store Redis (obligatoire en production)
OTP_PEPPER=changez_ce_pepper_long_aleatoire
# Vercel KV / Upstash (au moins une paire)
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=AXxxxxxxxx
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry — Monitoring erreurs (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@xxxx.ingest.sentry.io/xxxxxxxx

# Sécurité interne
INTERNAL_API_TOKEN=changez_ce_token_secret_en_production
CRON_SECRET=changez_ce_cron_secret

# Compte de test E2E (scripts/auth-smoke.mjs, scripts/verify-admin-fix.mjs)
# À renseigner dans l'environnement ou .env.local. Ne jamais commiter les vraies valeurs.
E2E_EMAIL=
E2E_PASSWORD=
